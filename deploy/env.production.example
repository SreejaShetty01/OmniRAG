# Copy to deploy/env.production, fill all REPLACE values, and restrict the file
# to the service account. Never commit deploy/env.production.

QDRANT_IMAGE=qdrant/qdrant@sha256:REPLACE_WITH_VERIFIED_64_HEX_DIGEST
OMNIRAG_API_IMAGE=registry.example.com/omnirag-api@sha256:REPLACE_WITH_VERIFIED_64_HEX_DIGEST
NODE_IMAGE=node:22-alpine@sha256:REPLACE_WITH_VERIFIED_64_HEX_DIGEST
PYTHON_IMAGE=python:3.11-slim@sha256:REPLACE_WITH_VERIFIED_64_HEX_DIGEST
OMNIRAG_API_CPUS=2.0
OMNIRAG_API_MEMORY_LIMIT=4g
QDRANT_CPUS=1.0
QDRANT_MEMORY_LIMIT=2g

OMNIRAG_AUTH_SHARED_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES
QDRANT_API_KEY=REPLACE_WITH_A_DIFFERENT_RANDOM_QDRANT_KEY
OMNIRAG_ACCEPTED_IDENTITIES_JSON=[{"user_id":"REPLACE_WITH_USER_ID","tenant_id":"REPLACE_WITH_TENANT_ID"}]
OMNIRAG_CORS_ORIGINS=["https://app.example.com"]
OMNIRAG_RATE_LIMIT_REQUESTS_PER_MINUTE=120
OMNIRAG_OLLAMA_HEALTH_URL=http://host.docker.internal:11434/api/tags

OMNIRAG_QDRANT_COLLECTION=omnirag
OMNIRAG_QDRANT_API_KEY=
OMNIRAG_DEFAULT_PROFILE=core
OMNIRAG_LOG_LEVEL=INFO
OMNIRAG_MAX_UPLOAD_BYTES=20000000

# Local-only provider example. Update model identifiers and dimensions to the
# models that have been independently pulled and validated on the target host.
OMNIRAG_EMBEDDING_PROVIDER=openai_compatible
OMNIRAG_EMBEDDING_MODEL_ID=nomic-embed-text
OMNIRAG_EMBEDDING_ENDPOINT=http://host.docker.internal:11434/v1
OMNIRAG_EMBEDDING_DIMENSIONS=768
OMNIRAG_EMBEDDING_SPACE_ALIAS=nomic-embed-text-768
OMNIRAG_EMBEDDING_API_KEY=

OMNIRAG_GENERATION_PROVIDER=openai_compatible
OMNIRAG_GENERATION_MODEL_ID=llama3.2:3b
OMNIRAG_GENERATION_ENDPOINT=http://host.docker.internal:11434/v1
OMNIRAG_GENERATION_API_KEY=
OMNIRAG_GENERATION_TIMEOUT_SECONDS=90
OMNIRAG_GENERATION_MAX_RETRIES=1
OMNIRAG_GENERATION_TEMPERATURE=0
OMNIRAG_GENERATION_MAX_OUTPUT_TOKENS=1200
OMNIRAG_GENERATION_MAX_CORRECTIONS=1

# Leave optional roles blank until each provider/model is selected and verified.
OMNIRAG_RERANKER_PROVIDER=
OMNIRAG_RERANKER_MODEL_ID=
OMNIRAG_RERANKER_ENDPOINT=
OMNIRAG_RERANKER_API_KEY=
OMNIRAG_VERIFICATION_PROVIDER=
OMNIRAG_VERIFICATION_MODEL_ID=
OMNIRAG_VERIFICATION_ENDPOINT=
OMNIRAG_VERIFICATION_API_KEY=

OMNIRAG_VALIDATION_MAX_COST_USD=0
OMNIRAG_VALIDATION_MAX_TOTAL_TOKENS=4200000
OMNIRAG_VALIDATION_MAX_CALLS=3000
OMNIRAG_PROVIDER_PRICE_TABLE_JSON={"openai_compatible/llama3.2:3b":{"input_per_million_usd":0,"output_per_million_usd":0},"openai_compatible/nomic-embed-text":{"input_per_million_usd":0,"output_per_million_usd":0}}
