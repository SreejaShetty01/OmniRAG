
OMNIRAG_ENVIRONMENT=development
OMNIRAG_LOG_LEVEL=INFO
OMNIRAG_API_HOST=0.0.0.0
OMNIRAG_API_PORT=8000
OMNIRAG_DEFAULT_PROFILE=core

# Authentication
# Configure only when using a trusted reverse proxy.
# OMNIRAG_AUTH_SHARED_SECRET=
# OMNIRAG_CORS_ORIGINS=["https://workspace.example.com"]

# Qdrant
# Docker Compose API container uses the service hostname.
OMNIRAG_QDRANT_URL=http://qdrant:6333
# OMNIRAG_QDRANT_API_KEY=

# General settings
OMNIRAG_CACHE_TTL_SECONDS=300
OMNIRAG_MAX_UPLOAD_BYTES=20000000
OMNIRAG_RATE_LIMIT_REQUESTS_PER_MINUTE=120
# Optional: configure only when Ollama availability should gate API readiness.
# OMNIRAG_OLLAMA_HEALTH_URL=http://host.docker.internal:11434/api/tags

# Chunking
OMNIRAG_CHUNK_MAX_TOKENS=500
OMNIRAG_CHUNK_OVERLAP_TOKENS=50
OMNIRAG_CHUNK_CONTEXTUALIZATION_ENABLED=true

# Local Ollama embeddings
OMNIRAG_EMBEDDING_PROVIDER=openai_compatible
OMNIRAG_EMBEDDING_MODEL_ID=nomic-embed-text
OMNIRAG_EMBEDDING_ENDPOINT=http://host.docker.internal:11434/v1
OMNIRAG_EMBEDDING_DIMENSIONS=768
OMNIRAG_EMBEDDING_BATCH_SIZE=32

# Qdrant collection
OMNIRAG_QDRANT_COLLECTION=omnirag
OMNIRAG_DENSE_VECTOR_NAME=dense
OMNIRAG_SPARSE_VECTOR_NAME=sparse

# Local Ollama generation
OMNIRAG_GENERATION_PROVIDER=openai_compatible
OMNIRAG_GENERATION_MODEL_ID=llama3.2:3b
OMNIRAG_GENERATION_ENDPOINT=http://host.docker.internal:11434/v1
# Ollama does not require an API key.
# OMNIRAG_GENERATION_API_KEY=

# Generation controls
OMNIRAG_GENERATION_TIMEOUT_SECONDS=90
OMNIRAG_GENERATION_MAX_RETRIES=1
OMNIRAG_GENERATION_TEMPERATURE=0
OMNIRAG_GENERATION_MAX_OUTPUT_TOKENS=1200
OMNIRAG_GENERATION_MAX_CORRECTIONS=1

# Semantic verification not configured yet.
# OMNIRAG_VERIFICATION_PROVIDER=
# OMNIRAG_VERIFICATION_MODEL_ID=
# OMNIRAG_VERIFICATION_ENDPOINT=
# OMNIRAG_VERIFICATION_API_KEY=

OMNIRAG_VERIFICATION_TIMEOUT_SECONDS=30
